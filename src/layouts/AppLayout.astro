---
import "../styles/global.css";
import { TopbarControls } from "../shared/ui/TopbarControls";
import type { UserSession } from "../core/types";
import { createDirectoryRepository } from "../modules/vacations/repositories/directory.repository";

interface Props {
  title?: string;
  breadcrumbs?: string[];
  session?: UserSession | null;
  isPublic?: boolean;
}

const {
  title = "Cetemet Control",
  breadcrumbs = [],
  session = null,
  isPublic = false,
} = Astro.props;
const pathname = Astro.url.pathname;
const ERP_TITLE = "cetemet-control-web";
const directoryRepository = createDirectoryRepository();

const formatMenuUserName = (userSession?: UserSession | null): string => {
  if (!userSession) return "General";
  const base =
    userSession.displayName?.trim() || userSession.email.split("@")[0] || "";
  const normalized = base.replace(/[._-]+/g, " ").replace(/\s+/g, " ").trim();
  if (!normalized) return "General";
  const words = normalized.split(" ");
  const visibleWords =
    words.length >= 2 ? words.slice(0, 2) : words.slice(0, 1);
  return visibleWords
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())
    .join(" ");
};


// 2. Reemplaza tu isActivePath actual (Línea 40-43) por el motor de exclusión
const isActivePath = (href: string): boolean => {
  const currentPathWithSearch = pathname + Astro.url.search;
  
  if (currentPathWithSearch === href) return true;

  const [baseHref, hrefSearch] = href.split('?');
  
  if (hrefSearch) return false;

  if (baseHref === '/control-horario' && pathname.startsWith('/control-horario/gestion')) return false;
  if (baseHref === '/vacaciones' && pathname.startsWith('/admin/vacaciones')) return false;
  if (baseHref === '/proyectos' && (pathname.startsWith('/admin/proyectos') || pathname.startsWith('/templa/'))) return false;

  if (pathname === baseHref) return true;
  return pathname.startsWith(`${baseHref}/`);
};

const getSidebarLinkClass = (isActive: boolean): string =>
  isActive
    ? "flex items-center gap-3 rounded-lg px-3 py-2 text-sm transition-all duration-200 bg-slate-900 text-white shadow-md shadow-slate-200"
    : "flex items-center gap-3 rounded-lg px-3 py-2 text-sm transition-all duration-200 text-slate-600 hover:bg-slate-50 hover:text-slate-900";

const currentUser = session
  ? await directoryRepository.findUserByEmail(session.email)
  : null;
const allDepartments = await directoryRepository.listDepartments();
const currentDepartmentName =
  allDepartments.find((department) => department.id === currentUser?.departmentId)
    ?.name ?? "";
const isCaffEngineeringWorker =
  session?.role === "Empleado" &&
  currentDepartmentName.trim().toLowerCase() === "cetemet engineering";
const coordinatorDepartments = currentUser
  ? await directoryRepository.listDepartmentsByCoordinator(currentUser.id)
  : [];

const canAccessTimeControlManagement =
  session?.role === "Admin" || session?.role === "Responsable" || session?.canManageTimeControlRequests;
const navItems = [
  { label: "Dashboard", href: "/dashboard" },
  { label: "Proyectos", href: "/proyectos" },
  { label: "Vacaciones", href: "/vacaciones" },
  { label: "Horas", href: "/horas" },
  { label: "Mi control horario", href: "/control-horario" },
  ...(canAccessTimeControlManagement
    ? [{ label: "Gestion de control horario", href: "/control-horario/gestion" }]
    : []),
  ...(isCaffEngineeringWorker
    ? [{ label: "Horas CAFF", href: "/horas-caff" }]
    : []),
  { label: "Reporting", href: "/reporting" },
];

const visibleNavItems =
  session?.role === "Empleado"
    ? navItems.filter((item) => item.href !== "/vacaciones-departamento")
    : navItems;

const adminGeneralNavItems = [
  { label: "Inicio", href: "/dashboard" },
  { label: "Proyectos", href: "/proyectos" },
  { label: "Vacaciones", href: "/vacaciones" },
  { label: "Horas", href: "/horas" },
  { label: "Mi control horario", href: "/control-horario" },
  ...(isCaffEngineeringWorker
    ? [{ label: "Horas CAFF", href: "/horas-caff" }]
    : []),
  { label: "Reporting", href: "/reporting" },
  { label: "Calendario", href: "/admin/calendario" },
];

const timeControlItemHrefs = new Set(["/control-horario/gestion"]);

const generalNavItems = visibleNavItems.filter(
  (item) => !timeControlItemHrefs.has(item.href),
);

const timeControlSectionItems = visibleNavItems.filter((item) =>
  timeControlItemHrefs.has(item.href) && 
  coordinatorDepartments.length === 0 && 
  session?.role !== "Admin",
);

// 1. Modifica adminSidebarSections para que las rutas sean únicas
const adminSidebarSections = [
  {
    title: "", 
    items: adminGeneralNavItems, 
  },
  {
    title: "MÓDULO FICHAJES",
    items: canAccessTimeControlManagement
      ? [{ label: "Control de Trabajadores", href: "/control-horario/gestion" }] 
      : [],
  },
  {
    title: "ADMINISTRACIÓN",
    items: [
      // Transformación: Asignar ruta única de administración
      { label: "Gestión de Proyectos", href: "/admin/proyectos" }, 
    ],
  },
  {
    title: "MÓDULO VACACIONES",
    items: [
      { label: "Control de Vacaciones", href: "/admin/vacaciones" } 
    ],
  },
  // ... resto del bloque sin cambios
].filter((section) => section.items.length > 0);

const visibleAdminSidebarSections = adminSidebarSections
  .map((section) => ({
    ...section,
    items: section.items.filter((item) => item.href !== "/admin/proyectos"),
  }))
  .filter((section) => section.items.length > 0);

const coordinatorSections = coordinatorDepartments.map((department) => ({
  // 1. Pasamos el nombre a mayúsculas para que tenga el mismo peso visual que "ADMINISTRACIÓN" o "TEMPLA"
  title: department.name.toUpperCase(),
  items: [
    {
      // Este ya clava el estilo "Vacaciones de Administración" que le gusta a tu tutor, pero por departamento
      label: `Vacaciones de ${department.name}`,
      href: `/vacaciones-departamento?departmentId=${department.id}`,
    },
    ...(canAccessTimeControlManagement
      ? [
          {
            // 2. Cambiamos el nombre por el término simplificado del diseño oscuro
            label: "Control de Trabajadores",
            href: "/control-horario/gestion",
          },
        ]
      : []),
  ],
}));

const showTimeControlSection = timeControlSectionItems.length > 0;
const coordinatorNavSections = coordinatorSections;

/* const timeControlSection = {
  title: "Control Horario",
  items: [
    { label: "Mi control horario", href: "/control-horario" },
    ...(canAccessTimeControlManagement
      ? [
          {
            label: "Gestión de control horario",
            href: "/control-horario/gestion",
          },
        ]
      : []),
  ],
}; */
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-100 text-slate-900 antialiased">
    {isPublic && (
      <main class="grid min-h-screen place-items-center px-4 py-8">
        <div class="w-full max-w-md">
          <slot />
        </div>
      </main>
    )}

    {!isPublic && (
      <div class="min-h-screen flex flex-col md:flex-row">
        <aside 
          id="sidebar"
          class="fixed inset-y-0 left-0 z-50 w-[86vw] max-w-72 shrink-0 bg-white border-r border-slate-200 transform -translate-x-full transition-transform duration-300 ease-in-out md:sticky md:top-0 md:h-screen md:w-72 md:translate-x-0 md:inset-auto"
        >
          <div class="flex flex-col h-full">
            <div class="p-5 border-b border-slate-100 flex items-center justify-between gap-2">
              <a href="/dashboard" class="flex items-center gap-2 min-w-0">
                <div class="w-8 h-8 bg-slate-900 rounded-lg flex items-center justify-center shrink-0">
                  <span class="text-white font-bold text-lg">C</span>
                </div>
                <span class="font-bold text-slate-900 tracking-tight truncate">cetemet-control</span>
              </a>
              
              <button 
                id="close-sidebar" 
                class="group p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-50 border border-slate-100 rounded-lg transition-all active:scale-95 shadow-sm shrink-0 flex items-center justify-center"
                aria-label="Ocultar menú lateral"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:-translate-x-0.5">
                  <rect width="18" height="18" x="3" y="3" rx="2" />
                  <path d="M9 3v16" />
                  <path d="m16 15-3-3 3-3" />
                </svg>
              </button>
            </div>

            <div class="flex-1 overflow-y-auto py-4 px-3 custom-scrollbar">
              {session?.role === "Admin" ? (
                visibleAdminSidebarSections.map((section, index) => (
                  <nav class:list={["space-y-1", index > 0 && "mt-6"]}>
                    <p class="px-3 mb-2 text-[10px] font-bold text-slate-400 uppercase tracking-widest">
                      {section.title}
                    </p>
                    {section.items.map((item) => (
                      <a
                        href={item.href}
                        class={getSidebarLinkClass(isActivePath(item.href))}
                      >
                        {item.label}
                      </a>
                    ))}
                  </nav>
                ))
              ) : (
                <>
              <nav class="space-y-1">
                 <p class="px-3 mb-2 text-[10px] font-bold text-slate-400 uppercase tracking-widest">General</p>
                 {generalNavItems.map((item) => (
                   <a
                     href={item.href}
                     class={getSidebarLinkClass(isActivePath(item.href))}
                   >
                     {item.label}
                   </a>
                 ))}
              </nav>

              {showTimeControlSection ? (
                <nav class="mt-6 space-y-1">
                  <p class="px-3 mb-2 text-[10px] font-bold text-slate-400 uppercase tracking-widest">Control Horario</p>
                  {timeControlSectionItems.map((item) => (
                    <a
                      href={item.href}
                      class={getSidebarLinkClass(isActivePath(item.href))}
                    >
                      {item.label}
                    </a>
                  ))}
                </nav>
              ) : null}

              {coordinatorNavSections.map((section) => (
                <nav class="mt-6 space-y-1">
                  <p class="px-3 mb-2 text-[10px] font-bold text-slate-400 uppercase tracking-widest">{section.title}</p>
                  {section.items.map((item) => (
                    <a
                      href={item.href}
                      class={getSidebarLinkClass(isActivePath(item.href))}
                    >
                      {item.label}
                    </a>
                  ))}
                </nav>
              ))}

                </>
              )}
            </div>

            <div class="p-4 border-t border-slate-100 bg-slate-50/50">
               <div class="flex items-center gap-3 px-2">
                 <div class="w-10 h-10 rounded-full bg-slate-200 flex items-center justify-center text-slate-600 font-bold border-2 border-white shadow-sm">
                   {formatMenuUserName(session).charAt(0)}
                 </div>
                 <div class="flex-1 min-w-0">
                   <p class="text-sm font-bold text-slate-900 truncate">{formatMenuUserName(session)}</p>
                   <p class="text-[10px] text-slate-500 font-medium uppercase tracking-wider">{session?.role || 'Usuario'}</p>
                 </div>
               </div>
            </div>
          </div>
        </aside>

        <div id="sidebar-backdrop" class="fixed inset-0 z-40 bg-slate-900/50 backdrop-blur-sm hidden md:hidden"></div>

        <div class="flex-1 flex flex-col min-w-0">
          <header class="sticky top-0 z-40 border-b border-slate-200 bg-white/80 backdrop-blur-md">
            <div class="flex items-center justify-between gap-3 px-4 py-3 md:px-6">
              <div class="flex min-w-0 items-center gap-2 md:gap-3">
                
                <button 
                  id="toggle-sidebar"
                  class="group p-2 text-slate-500 hover:text-slate-700 hover:bg-slate-100 border border-transparent hover:border-slate-200 rounded-lg transition-all active:scale-95 flex items-center justify-center bg-white shadow-sm ring-1 ring-slate-100 shrink-0"
                  aria-label="Mostrar menú lateral"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-0.5">
                    <rect width="18" height="18" x="3" y="3" rx="2" />
                    <path d="M9 3v16" />
                    <path d="m14 9 3 3-3 3" />
                  </svg>
                </button>
                
                <div class="flex items-center md:hidden">
                  <span class="font-bold text-slate-900 tracking-tight">cetemet</span>
                </div>

                <div class="hidden md:block min-w-0">
                  <div class="text-sm text-slate-500 font-medium truncate">
                    {breadcrumbs.length > 0 ? (
                      <div class="flex items-center gap-2 min-w-0">
                        <a href="/dashboard" class="hover:text-slate-900 transition-colors shrink-0">Inicio</a>
                        {breadcrumbs.map((crumb) => (
                          <span class="flex items-center gap-2 min-w-0">
                            <svg class="w-4 h-4 text-slate-300 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                            <span class="text-slate-900 truncate">{crumb}</span>
                          </span>
                        ))}
                      </div>
                    ) : (
                      <span class="text-slate-900">Dashboard</span>
                    )}
                  </div>
                </div>
              </div>
              
              <div class="flex min-w-0 items-center gap-2 md:gap-4">
                <div class="hidden sm:block">
                  <TopbarControls
                    client:load
                    initialSession={session}
                    showYear={true}
                    showSession={false}
                    showRole={false}
                    showLogout={false}
                  />
                </div>
                <TopbarControls
                  client:load
                  initialSession={session}
                  showYear={false}
                />
              </div>
            </div>
          </header>
          <main class="flex-1 px-3 py-4 sm:p-4 md:p-6 xl:p-8">
            <slot />
          </main>
        </div>
      </div>
    )}
    <script>
      const sidebar = document.getElementById("sidebar");
      const backdrop = document.getElementById("sidebar-backdrop");
      const toggleBtn = document.getElementById("toggle-sidebar");
      const closeBtn = document.getElementById("close-sidebar");

      const desktopSidebarStorageKey = "cetemet:sidebar-hidden";

      function isDesktopSidebar() {
        return window.innerWidth >= 768;
      }

      // NUEVO: Función para sincronizar la visibilidad del botón de abrir (Header)
      function syncToggleBtn() {
        if (!toggleBtn) return;
        let isHidden = false;
        
        // Comprobamos si el menú está oculto dependiendo de si estamos en PC o Móvil
        if (isDesktopSidebar()) {
          isHidden = document.body.classList.contains("sidebar-desktop-hidden");
        } else {
          isHidden = sidebar.classList.contains("-translate-x-full");
        }

        // Si el menú está oculto, mostramos el botón de abrir. Si no, lo escondemos.
        if (isHidden) {
          toggleBtn.style.display = "flex";
        } else {
          toggleBtn.style.display = "none";
        }
      }

      function setDesktopSidebarHidden(isHidden: boolean) {
        document.body.classList.toggle("sidebar-desktop-hidden", isHidden);
        try {
          window.localStorage.setItem(
            desktopSidebarStorageKey,
            isHidden ? "1" : "0",
          );
        } catch {
          // El menú sigue funcionando aunque localStorage no esté disponible.
        }
        // NUEVO: Sincronizar botón al cambiar en PC
        syncToggleBtn();
      }

      function toggleSidebar() {
        if (!sidebar || !backdrop) return;

        if (isDesktopSidebar()) {
          setDesktopSidebarHidden(
            !document.body.classList.contains("sidebar-desktop-hidden"),
          );
          return;
        }

        const isOpen = !sidebar.classList.contains("-translate-x-full");
        
        if (isOpen) {
          sidebar.classList.add("-translate-x-full");
          backdrop.classList.add("hidden");
          document.body.classList.remove("overflow-hidden");
        } else {
          sidebar.classList.remove("-translate-x-full");
          backdrop.classList.remove("hidden");
          document.body.classList.add("overflow-hidden");
        }
        // NUEVO: Sincronizar botón al cambiar en móvil
        syncToggleBtn();
      }

      toggleBtn?.addEventListener("click", toggleSidebar);
      closeBtn?.addEventListener("click", toggleSidebar);
      backdrop?.addEventListener("click", toggleSidebar);

      try {
        if (window.localStorage.getItem(desktopSidebarStorageKey) === "1") {
          document.body.classList.add("sidebar-desktop-hidden");
        }
      } catch {
        // Preferimos mostrar el menú si no se puede leer la preferencia.
      }

      // NUEVO: Ejecución inicial para revisar cómo arranca el panel
      syncToggleBtn();

      // Cerrar al redimensionar si pasamos a desktop
      window.addEventListener("resize", () => {
        if (window.innerWidth >= 768 && sidebar && !sidebar.classList.contains("-translate-x-full")) {
          sidebar.classList.add("-translate-x-full");
          backdrop?.classList.add("hidden");
          document.body.classList.remove("overflow-hidden");
        }
        if (window.innerWidth < 768) {
          document.body.classList.remove("sidebar-desktop-hidden");
        }
        // NUEVO: Sincronizar botón si el usuario cambia el tamaño de la ventana
        syncToggleBtn();
      });
</script>
    <style is:global>
      .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
        height: 4px;
      }
      .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
      }
      .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #e2e8f0;
        border-radius: 10px;
      }
      .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #cbd5e1;
      }

      /* Utility to hide scrollbar while keeping functionality */
      .scrollbar-hide::-webkit-scrollbar {
        display: none;
      }
      .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }

      @media (min-width: 768px) {
        body.sidebar-desktop-hidden #sidebar {
          display: none;
        }
      }
    </style>
  </body>
</html>
