---
import AppLayout from "../layouts/AppLayout.astro";
import { requireAuth } from "../core/router/guards";
import { AdminTimeWorkspace } from "../features/time/AdminTimeWorkspace";
import { WorkerTimeWorkspace } from "../features/time/WorkerTimeWorkspace";

const auth = requireAuth(Astro);
if (auth instanceof Response) return auth;
const session = auth;
---

<AppLayout
  title="Horas | Cetemet Control"
  session={session}
  breadcrumbs={["General", "Horas"]}
>
  {
    session.role === "Empleado" ? (
      <WorkerTimeWorkspace client:load session={session} />
    ) : (
      <AdminTimeWorkspace client:load session={session} />
    )
  }
</AppLayout>
