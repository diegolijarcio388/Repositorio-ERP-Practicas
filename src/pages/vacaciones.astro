---
import AppLayout from "../layouts/AppLayout.astro";
import { requireAuth } from "../core/router/guards";
import { WorkerVacationsWorkspace } from "../features/vacations/WorkerVacationsWorkspace";

const auth = requireAuth(Astro);
if (auth instanceof Response) return auth;
const session = auth;
---

<AppLayout
  title="Vacaciones | Cetemet Control"
  session={session}
  breadcrumbs={["General", "Vacaciones"]}
>
  <WorkerVacationsWorkspace client:load session={session} />
</AppLayout>
