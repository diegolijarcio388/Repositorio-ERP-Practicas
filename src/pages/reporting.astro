---
import AppLayout from "../layouts/AppLayout.astro";
import { requireAuth } from "../core/router/guards";
import { ReportingPlaceholder } from "../modules/reporting";

const auth = requireAuth(Astro);
if (auth instanceof Response) return auth;
const session = auth;
---

<AppLayout
  title="Reporting | Cetemet Control"
  session={session}
  breadcrumbs={["General", "Reporting"]}
>
  <ReportingPlaceholder client:load />
</AppLayout>
