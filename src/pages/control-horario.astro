---
import AppLayout from "../layouts/AppLayout.astro";
import { requireAuth } from "../core/router/guards";
import { WorkerTimeControlWorkspace } from "../features/time-control/WorkerTimeControlWorkspace";

const auth = requireAuth(Astro);
if (auth instanceof Response) return auth;
const session = auth;
---

<AppLayout
  title="Control Horario | Cetemet Control"
  session={session}
  breadcrumbs={["General", "Control Horario"]}
>
  <WorkerTimeControlWorkspace client:load session={session} />
</AppLayout>
