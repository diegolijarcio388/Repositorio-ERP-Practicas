---
import AppLayout from "../../layouts/AppLayout.astro";
import { requireAdmin } from "../../core/router/guards";
import { AdminCalendarWorkspace } from "../../features/vacations/AdminCalendarWorkspace";

const auth = requireAdmin(Astro);
if (auth instanceof Response) return auth;
const session = auth;
---

<AppLayout
  title="Calendario Festivos y Eventos | Cetemet Control"
  session={session}
  breadcrumbs={["Admin", "Calendario"]}
>
  <AdminCalendarWorkspace client:load />
</AppLayout>
