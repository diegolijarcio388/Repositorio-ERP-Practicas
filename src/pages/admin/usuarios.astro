---
import AppLayout from "../../layouts/AppLayout.astro";
import { requireAdmin } from "../../core/router/guards";
import { AdminUsersWorkspace } from "../../modules/admin";

const auth = requireAdmin(Astro);
if (auth instanceof Response) return auth;
const session = auth;
---

<AppLayout
  title="Admin Usuarios | Cetemet Control"
  session={session}
  breadcrumbs={["Admin", "Usuarios"]}
>
  <AdminUsersWorkspace client:load />
</AppLayout>
