---
import AppLayout from "../../layouts/AppLayout.astro";
import { requireAdmin } from "../../core/router/guards";
import { AdminVacationsWorkspace } from "../../features/vacations/AdminVacationsWorkspace";

const auth = requireAdmin(Astro);
if (auth instanceof Response) return auth;
const session = auth;
---

<AppLayout
  title="Vacaciones Admin | Cetemet Control"
  session={session}
  breadcrumbs={["Admin", "Vacaciones"]}
>
  <AdminVacationsWorkspace client:load />
</AppLayout>
