---
import AppLayout from "../../layouts/AppLayout.astro";
import { requireAuth } from "../../core/router/guards";
import { WorkerTimeControlRequestsWorkspace } from "../../features/time-control/WorkerTimeControlRequestsWorkspace";

const auth = requireAuth(Astro);
if (auth instanceof Response) return auth;
const session = auth;
---

<AppLayout
  title="Solicitudes de Control Horario | Cetemet Control"
  session={session}
  breadcrumbs={["General", "Control Horario", "Solicitudes"]}
>
  <WorkerTimeControlRequestsWorkspace client:load session={session} />
</AppLayout>
